<style>
@font-face{font-family:"Inter";src:url(brand/fonts/inter.woff2) format("woff2");font-weight:100 900;font-display:swap}
@font-face{font-family:"Inter Tight";src:url(brand/fonts/inter-tight.woff2) format("woff2");font-weight:100 900;font-display:swap}
:root{
  --bg:#FFFFFF;--bg2:#F5F6F8;--card:#FFFFFF;--ink:#0A0A0B;--ink2:#3F434B;--mute:#80858F;--line:#E8E9EC;
  --acc:#3D5AFE;--good:#0E9F6E;--bad:#E5484D;--goodbg:rgba(14,159,110,.08);--badbg:rgba(229,72,77,.07);--accbg:rgba(61,90,254,.08);
  --display:"Inter Tight","Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  --text:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  --ease:cubic-bezier(.16,1,.3,1);
  --spring:linear(0,.006,.025 2.8%,.101 6.1%,.539 18.9%,.721 25.3%,.849 31.5%,.937 38.1%,.968 41.8%,.991 45.7%,1.006 50.1%,1.015 55%,1.017 63.9%,1.001 85.9%,1);
  --s1:8px;--s2:16px;--s3:24px;--s4:32px;--s5:40px;--s6:48px;--s8:64px;--s10:80px;--s12:96px;--s16:128px;
  --r:24px;--max:1120px;
}
@media (prefers-color-scheme:dark){:root{
  --bg:#000000;--bg2:#0B0B0D;--card:#0B0B0D;--ink:#F4F5F7;--ink2:#B4B8C0;--mute:#71757E;--line:#1C1D21;
  --acc:#7C92FF;--good:#3DD6A3;--bad:#FF6B6F;--goodbg:rgba(61,214,163,.09);--badbg:rgba(255,107,111,.09);--accbg:rgba(124,146,255,.10);
}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:72px}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 var(--text);-webkit-font-smoothing:antialiased;overflow-x:hidden;font-feature-settings:"cv11","ss03"}
a{color:inherit}
.w{max-width:var(--max);margin:0 auto;padding:0 var(--s3)}
@media (min-width:768px){.w{padding:0 var(--s5)}}
.num{font-variant-numeric:tabular-nums}
h1,h2,h3,.big{font-family:var(--display);letter-spacing:-.035em;font-weight:650;margin:0}

/* nav */
.nav{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 80%,transparent);backdrop-filter:saturate(180%) blur(16px);-webkit-backdrop-filter:saturate(180%) blur(16px)}
.nav .in{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{display:flex;align-items:center;gap:var(--s1);text-decoration:none;font:650 18px/1 var(--display);letter-spacing:-.02em}
.logo img{width:28px;height:28px}
.nav ul{display:flex;gap:var(--s1);list-style:none;margin:0;padding:0}
.nav ul a{display:block;text-decoration:none;font-size:14px;color:var(--mute);padding:var(--s1) var(--s2);border-radius:999px;transition:color .2s,background .2s}
.nav ul a:hover{color:var(--ink)}
.nav ul a.on{color:var(--ink);background:var(--bg2)}
.prog{position:absolute;left:0;bottom:0;height:2px;width:100%;background:var(--acc);transform-origin:0 50%;transform:scaleX(0)}
@media (max-width:720px){.nav ul li:not(.k){display:none}}

/* hero */
.hero{padding:var(--s10) 0 var(--s8)}
@media (min-width:768px){.hero{padding:var(--s16) 0 var(--s12)}}
.eyebrow{font:500 14px/1 var(--text);color:var(--mute);display:flex;gap:var(--s1);align-items:center;margin-bottom:var(--s3)}
.eyebrow i{width:8px;height:8px;border-radius:50%;background:var(--good)}
h1{font-size:clamp(44px,8vw,96px);line-height:1;letter-spacing:-.04em;font-weight:700;max-width:12ch}
h1 span{color:var(--mute)}
.heronum{display:grid;grid-template-columns:1fr;gap:var(--s3);margin-top:var(--s8);align-items:end}
@media (min-width:900px){.heronum{grid-template-columns:auto 1fr;gap:var(--s8)}}
.big{font-size:clamp(64px,13vw,152px);line-height:.9;font-weight:700;letter-spacing:-.055em;color:var(--acc)}
.big small{font-size:.28em;letter-spacing:-.02em;color:var(--mute);font-weight:600;margin-left:var(--s2)}
.sub{font-size:clamp(18px,2vw,21px);line-height:1.5;color:var(--ink2);max-width:36ch;margin:0}
.sub b{color:var(--ink);font-weight:600}
.facts{display:flex;flex-wrap:wrap;gap:var(--s1);margin-top:var(--s5)}
.fact{display:inline-flex;gap:var(--s1);align-items:baseline;font-size:15px;padding:var(--s1) var(--s2);border-radius:999px;background:var(--bg2);color:var(--ink2)}
.fact b{font-family:var(--display);font-weight:650;color:var(--ink)}

/* sections */
section{padding:var(--s10) 0}
@media (min-width:768px){section{padding:var(--s12) 0}}
.kick{font:600 13px/1 var(--text);letter-spacing:.1em;text-transform:uppercase;color:var(--mute);margin-bottom:var(--s2)}
h2{font-size:clamp(32px,4.6vw,56px);line-height:1.04;max-width:18ch;margin-bottom:var(--s2)}
.lead{font-size:19px;color:var(--ink2);max-width:52ch;margin:0 0 var(--s5)}
.hr{height:1px;background:var(--line);margin:0}

/* chart card */
.chart{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:var(--s3) var(--s2) var(--s2);position:relative}
@media (min-width:768px){.chart{padding:var(--s4) var(--s4) var(--s3)}}
.chart h3{font-size:20px;letter-spacing:-.02em;padding:0 var(--s1);margin-bottom:var(--s1)}
.legend{display:flex;flex-wrap:wrap;gap:var(--s2);font-size:14px;color:var(--mute);padding:0 var(--s1);margin-bottom:var(--s2)}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.plot{position:relative;width:100%;touch-action:pan-y}
.plot svg{display:block;width:100%;overflow:visible}
.plot text{font:500 13px var(--text);fill:var(--mute)}
.plot .grid{stroke:var(--line);stroke-width:1}
.src{font-size:13px;color:var(--mute);padding:var(--s1) var(--s1) 0}
.src a{color:var(--mute)}
.tip{position:absolute;pointer-events:none;background:var(--ink);color:var(--bg);font:500 13px/1.45 var(--text);padding:var(--s1) 12px;border-radius:12px;white-space:nowrap;opacity:0;transform:translate(-50%,calc(-100% - 12px));transition:opacity .15s;z-index:5}
.tip b{font-family:var(--display);font-weight:650;font-size:15px}
.tip.on{opacity:1}
.grid2{display:grid;grid-template-columns:1fr;gap:var(--s2)}
@media (min-width:900px){.grid2{grid-template-columns:1fr 1fr}}

/* scorecards */
.cards{display:grid;grid-template-columns:1fr;gap:var(--s2)}
@media (min-width:900px){.cards{grid-template-columns:1fr 1fr}}
.card{border-radius:var(--r);padding:var(--s4) var(--s3);border:1px solid var(--line)}
@media (min-width:768px){.card{padding:var(--s5)}}
.card.for{background:var(--goodbg);border-color:color-mix(in srgb,var(--good) 22%,transparent)}
.card.against{background:var(--badbg);border-color:color-mix(in srgb,var(--bad) 22%,transparent)}
.card header{display:flex;align-items:center;gap:12px;margin-bottom:var(--s3)}
.card header span{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;font:700 20px/1 var(--display);color:#fff}
.card.for header span{background:var(--good)}.card.against header span{background:var(--bad)}
.card header h3{font-size:24px}
.stat{display:grid;grid-template-columns:auto 1fr;gap:var(--s2);align-items:baseline;padding:var(--s2) 0;border-top:1px solid color-mix(in srgb,var(--ink) 8%,transparent)}
.stat .v{font:700 clamp(32px,4vw,44px)/1 var(--display);letter-spacing:-.04em;min-width:4.2ch}
.card.for .v{color:var(--good)}.card.against .v{color:var(--bad)}
.stat p{margin:0;font-size:16px;line-height:1.45;color:var(--ink2)}
details{margin-top:var(--s2)}
summary{cursor:pointer;font-size:15px;font-weight:600;color:var(--ink);list-style:none;display:inline-flex;gap:var(--s1);align-items:center;padding:var(--s1) 0}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";font:500 18px/1 var(--text);color:var(--mute);transition:transform .3s var(--ease)}
details[open] summary::after{transform:rotate(45deg)}
details ul{margin:var(--s1) 0 0;padding-left:var(--s3);color:var(--ink2);font-size:15px;line-height:1.55}
details li{margin-bottom:var(--s1)}
a.lnk{color:inherit;font:inherit;text-decoration:underline;text-decoration-thickness:1.5px;text-decoration-color:color-mix(in srgb,var(--acc) 55%,transparent);text-underline-offset:4px}
a.lnk:hover{text-decoration-color:var(--acc)}

/* value bars */
.vbars{display:grid;gap:var(--s3);padding:var(--s1)}
.vb .row{display:flex;justify-content:space-between;font-size:15px;margin-bottom:var(--s1);color:var(--ink2)}
.vb .row b{font-family:var(--display);font-size:20px;color:var(--ink);letter-spacing:-.02em}
.vb .track{height:16px;border-radius:8px;background:var(--bg2);overflow:hidden}
.vb .fill{height:100%;border-radius:8px;transform-origin:0 50%;transform:scaleX(var(--f));transition:transform 1.2s var(--ease)}
.js .vbars:not(.in) .fill{transform:scaleX(0)}

/* falsifiers */
.fals{display:grid;grid-template-columns:1fr;gap:var(--s5);align-items:start}
@media (min-width:900px){.fals{grid-template-columns:5fr 7fr;gap:var(--s8)}}
.zero{font:700 clamp(96px,16vw,184px)/.85 var(--display);letter-spacing:-.06em}
.zero small{font-size:.3em;color:var(--mute);letter-spacing:-.02em;font-weight:600}
.dots{display:flex;gap:var(--s1);margin:var(--s3) 0}
.dots i{width:40px;height:8px;border-radius:4px;background:var(--good)}
.dots i.m{background:var(--bad)}
.flist{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.frow{display:grid;grid-template-columns:40px 1fr auto;grid-template-areas:"id name chip" "id val val";gap:4px var(--s2);padding:var(--s3) 0;border-bottom:1px solid var(--line);align-items:center}
@media (min-width:600px){.frow{grid-template-columns:48px 1fr 88px auto;grid-template-areas:"id name val chip"}}
.fid{grid-area:id;font:600 14px var(--mono);color:var(--mute)}
.fname{grid-area:name}.fname b{display:block;font-weight:600;font-size:17px;line-height:1.3}.fname small{display:block;color:var(--mute);font-size:14px;line-height:1.4;margin-top:2px}
.fval{grid-area:val;font:600 16px var(--display);color:var(--ink2);text-align:left}
@media (min-width:600px){.fval{text-align:right}}
.chip{grid-area:chip;font:600 13px/1 var(--text);padding:var(--s1) 12px;border-radius:999px;white-space:nowrap;justify-self:end}
.chip.ok{background:var(--goodbg);color:var(--good)}.chip.bad{background:var(--badbg);color:var(--bad)}

/* verdict */
.verdict{font:600 clamp(28px,4.2vw,52px)/1.12 var(--display);letter-spacing:-.035em;max-width:22ch;margin:0}
.verdict span{color:var(--mute)}
.method{display:grid;grid-template-columns:1fr;gap:var(--s3);margin-top:var(--s8)}
@media (min-width:900px){.method{grid-template-columns:1fr 1fr;gap:var(--s5)}}
.term{background:#0A0A0B;color:#E8EAEE;border:1px solid var(--line);border-radius:var(--r);padding:var(--s3);font:14px/1.9 var(--mono);white-space:pre;overflow-x:auto;position:relative}
.term .c{color:#71757E}.term .p{color:#7C92FF;user-select:none}
.copy{position:absolute;top:var(--s2);right:var(--s2);font:600 13px var(--text);color:#E8EAEE;background:rgba(255,255,255,.08);border:0;border-radius:999px;padding:var(--s1) var(--s2);cursor:pointer}
.copy:active{transform:scale(.95)}
.steps{margin:0;padding:0;list-style:none;display:grid;gap:var(--s2)}
.steps li{display:grid;grid-template-columns:32px 1fr;gap:var(--s2);font-size:16px;color:var(--ink2);line-height:1.5}
.steps li span{width:32px;height:32px;border-radius:10px;background:var(--accbg);color:var(--acc);display:grid;place-items:center;font:600 14px var(--display)}
.steps b{color:var(--ink)}
footer{padding:var(--s6) 0 calc(var(--s8) + env(safe-area-inset-bottom));border-top:1px solid var(--line);font-size:14px;color:var(--mute)}
footer .in{display:flex;flex-wrap:wrap;gap:var(--s2);justify-content:space-between;align-items:center}
footer a{color:var(--ink2)}

/* motion */
.js .r{opacity:0;transform:translate3d(0,24px,0)}
.js .r.in{opacity:1;transform:none;transition:opacity .8s var(--ease),transform 1s var(--spring);transition-delay:var(--d,0ms)}
@keyframes up{from{opacity:0;transform:translate3d(0,24px,0)}to{opacity:1;transform:none}}
.js .h{animation:up 1s var(--spring) both;animation-delay:var(--d,0ms)}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.js .r,.js .h{opacity:1!important;transform:none!important;transition:none!important;animation:none!important}.vb .fill{transition:none!important}.js .vbars:not(.in) .fill{transform:scaleX(var(--f))}}
</style>
</head>
<body>
<script>document.documentElement.classList.add("js")</script>
<nav class="nav" aria-label="Main">
  <div class="w in">
    <a class="logo" href="#top"><img src="brand/mark.svg" alt="" width="28" height="28">Settlemark</a>
    <ul><li><a href="#flow">Flow</a></li><li><a href="#case">The case</a></li><li><a href="#tests">Tests</a></li><li><a href="#verdict">Verdict</a></li><li class="k"><a href="$repo" rel="noopener">GitHub</a></li></ul>
  </div>
  <div class="prog" id="prog"></div>
</nav>

<main id="top">
<header class="hero"><div class="w">
  <div class="eyebrow h"><i></i>Research note 01 · NEAR Intents · data to $end</div>
  <h1 class="h" style="--d:80ms">NEAR is becoming a settlement layer. <span>Its token has not caught up.</span></h1>
  <div class="heronum">
    <div class="big num h" style="--d:200ms"><span data-count="$k_iv1" data-dec="1" data-pre="$$" data-suf="M">$$${k_iv1}M</span><small>a week</small></div>
    <p class="sub h" style="--d:280ms">settled through NEAR Intents, up from <b>$iv0</b>. Over the same months the NEAR price <b>fell from $p0 to $p1</b>.</p>
  </div>
  <div class="facts h" style="--d:360ms">
    <span class="fact">Price correlation <b class="num">$k_corr_txt</b></span>
    <span class="fact">Market cap <b class="num">${k_mrev}x</b> yearly revenue</span>
    <span class="fact">Falsifiers met <b class="num">$met of $nf</b></span>
  </div>
</div></header>

<div class="w"><div class="hr"></div></div>

<section id="flow">
  <div class="w">
    <div class="kick r">01 · The flow</div>
    <h2 class="r">Usage climbed while the price slid.</h2>
    <p class="lead r">Weekly Intents volume against the NEAR price. Hover or tap any week.</p>
    <div class="chart r">
      <div class="legend"><span><i style="background:var(--acc)"></i>Intents weekly volume</span><span><i style="background:var(--ink)"></i>NEAR price, right axis</span></div>
      <div class="plot" id="c-flow" role="img" aria-label="Weekly NEAR Intents volume rising from under one million to hundreds of millions of dollars while the NEAR price fell"></div>
      <div class="src">Source: <a href="$u_iv" rel="noopener">DefiLlama</a>, NearBlocks. $weeks weeks, $start to $end.</div>
    </div>
  </div>
</section>

<section id="case">
  <div class="w">
    <div class="kick r">02 · The case</div>
    <h2 class="r">For and against, weighed the same.</h2>
    <p class="lead r">Each half of the thesis tested on its own, so one cannot hide the other.</p>
    <div class="cards">
      <article class="card for r">
        <header><span>+</span><h3>Usage is real</h3></header>
        <div class="stat"><div class="v num">$k_share%</div><p>of all onchain DEX volume now runs through Intents, up from $x_share0.</p></div>
        <div class="stat"><div class="v num">$k_corr_txt</div><p>correlation of weekly volume changes with NEAR price. Price does not drive usage.</p></div>
        <div class="stat"><div class="v num">$x_btc</div><p>correlation with Bitcoin. Not crypto beta either.</p></div>
        <details><summary>All evidence for</summary><ul>
          <li>Weekly volume went from $iv0 to $iv1 (first versus last 4 weeks), while price went from $p0 to $p1.</li>
          <li>Share of DEX volume: $share0, then $share1, then $share2 (first, previous and latest 13 weeks).</li>
          <li>Correlation $corr, 90% bootstrap interval $ci, over $weeks weeks.</li>
          <li>Neither leads: price last week against volume this week $lag1; the reverse $lag2.</li>
          <li>Bitcoin $btc over $wbtc weeks. It does follow the whole DEX market ($dexc), as a venue should.</li>
          <li>Last 365 days: $iv365 settled, $fee365 in fees.</li>
        </ul></details>
      </article>
      <article class="card against r" style="--d:100ms">
        <header><span>&minus;</span><h3>Holders capture little</h3></header>
        <div class="stat"><div class="v num">${k_mrev}x</div><p>NEAR market cap to yearly Intents revenue. The token keeps a thin slice.</p></div>
        <div class="stat"><div class="v num">$x_aa_drop%</div><p>daily active accounts on NEAR, first versus latest quarter.</p></div>
        <div class="stat"><div class="v num">$x_st_drop%</div><p>stablecoins on NEAR over the last year.</p></div>
        <details><summary>All evidence against</summary><ul>
          <li>Intents kept $rev365 of revenue in 365 days, about $bps basis points of volume. Chain gas fees: $chain365. Market cap $mcap is $mrev revenue and $mchain chain fees.</li>
          <li>Levels point the wrong way: log volume against log price correlates at $lvl.</li>
          <li>Active accounts averaged $aa0, then $aa1. Some may be bots leaving.</li>
          <li>Stablecoins fell from $st0 to $st1.</li>
          <li>Volume can flatter: <a class="lnk" href="https://github.com/soldanoandrea/near-thesis" rel="noopener">near-thesis</a> found public swaps match only part of reported volume on sampled days.</li>
        </ul></details>
      </article>
    </div>
    <div class="grid2" style="margin-top:var(--s2)">
      <div class="chart r"><h3>Share of all DEX volume</h3><div class="legend"><span><i style="background:var(--good)"></i>Intents, weekly %</span></div><div class="plot" id="c-share" role="img" aria-label="Intents share of all DEX volume rising to over one percent"></div><div class="src">Source: <a href="$u_dex" rel="noopener">DefiLlama</a></div></div>
      <div class="chart r" style="--d:80ms"><h3>Weekly changes</h3><div class="legend"><span><i style="background:var(--acc)"></i>Each dot is one week. r = $k_corr_txt</span></div><div class="plot" id="c-scatter" role="img" aria-label="Scatter of weekly price changes against weekly volume changes with no clear pattern"></div><div class="src">x: NEAR price change %, y: Intents volume change %</div></div>
      <div class="chart r"><h3>Where the money goes, last 365 days</h3><div class="vbars" id="c-value"></div><div class="src">Source: <a href="$u_rev" rel="noopener">DefiLlama</a>, NearBlocks</div></div>
      <div class="chart r" style="--d:80ms"><h3>Base chain activity</h3><div class="legend"><span><i style="background:var(--bad)"></i>Active accounts per day, weekly average</span></div><div class="plot" id="c-aa" role="img" aria-label="NEAR daily active accounts falling"></div><div class="src">Source: NearBlocks</div></div>
    </div>
  </div>
</section>

<section id="tests" style="background:var(--bg2)">
  <div class="w fals">
    <div>
      <div class="kick r">03 · What would change our mind</div>
      <div class="zero num r">$met<small> of $nf</small></div>
      <div class="dots r" aria-hidden="true">$meter</div>
      <p class="lead r">tests that would prove the thesis wrong are met. Thresholds live in <code>settlemark.toml</code> and run on every rebuild.</p>
    </div>
    <ul class="flist">
$falsifier_rows
    </ul>
  </div>
</section>

<section id="verdict">
  <div class="w">
    <div class="kick r">04 · Verdict</div>
    <p class="verdict r">The use is real. <span>The value capture is not there yet.</span> NEAR is a long term buy only if that changes. Watch revenue, not price.</p>
    <div class="method">
      <div class="term r"><button class="copy" type="button" data-copy="git clone $repo && cd near-settlement-thesis && npm run setup && npm run rebuild && npm test">Copy</button><span class="c"># no keys, no accounts, no cost</span>
<span class="p">$$ </span>npm run setup
<span class="p">$$ </span>npm run rebuild
<span class="p">$$ </span>npm test</div>
      <ol class="steps r" style="--d:80ms">
        <li><span>1</span><div><b>Fetch</b> nine public datasets with retries and caching. Every row keeps its source and time.</div></li>
        <li><span>2</span><div><b>Validate</b> each file against a schema before any maths.</div></li>
        <li><span>3</span><div><b>Analyse</b> weekly changes with bootstrap intervals and a fixed seed.</div></li>
        <li><span>4</span><div><b>Render</b> this page, THESIS.md and every chart. No number typed by hand.</div></li>
      </ol>
    </div>
    <details class="r" style="margin-top:var(--s5)"><summary>Limits</summary><ul>
      <li>Free public APIs only. The Intents Explorer API needs a partner token and was not used.</li>
      <li>$bq</li>
      <li>Weekly correlations over two years are noisy, and early weeks are tiny.</li>
      <li>NearBlocks can miss signers behind relayers. CoinGecko's free tier gives 365 days, so the Bitcoin test is shorter.</li>
    </ul></details>
  </div>
