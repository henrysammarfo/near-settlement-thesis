{
  "name": "settlemark-near-settlement-thesis",
  "version": "2.0.0",
  "private": true,
  "description": "Settlemark research note 01: the NEAR settlement thesis, rebuilt from public data with one command.",
  "license": "MIT",
  "scripts": {
    "setup": "python3 -m venv .venv && .venv/bin/python -m pip install -q -r requirements.txt",
    "rebuild": "sh rebuild.sh",
    "build": "sh -c '[ -x .venv/bin/python ] && P=.venv/bin/python || P=python3; $P -m settlemark build'",
    "test": "sh -c '[ -x .venv/bin/python ] && P=.venv/bin/python || P=python3; $P -m pytest'",
    "lint": "make lint"
  }
}
